# =====================================================================
# Variables de entorno de la plantilla.
#
# 1. Copie este archivo como .env  (cp .env.example .env)
# 2. Cambie la contraseña.
#
# El archivo .env NUNCA se sube al repositorio (ya está en .gitignore).
# =====================================================================

# --- Base de datos ---
POSTGRES_DB=plantilla
POSTGRES_USER=plantilla
POSTGRES_PASSWORD=cambie_esta_contrasena

# --- Puertos en su equipo ---
# Si alguno ya está ocupado (por ejemplo, un PostgreSQL instalado), cámbielo.
DB_HOST_PORT=5432
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=5173

# --- CORS ---
# Orígenes que pueden llamar a la API, separados por comas.
# Si cambia FRONTEND_HOST_PORT, actualice también estos valores.
CORS_ORIGENES_PERMITIDOS=http://localhost:5173,http://127.0.0.1:5173

# --- Desarrollo en Docker Desktop (Windows/macOS) ---
# Póngalo en true si el frontend no recarga al guardar cambios.
VITE_WATCH_POLLING=false
